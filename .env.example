# Local server
SNAPLEDGER_PORT=3801

# CockroachDB Cloud (required for cloud ledger and memory Q&A)
COCKROACH_DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# Keep the shared public deployment read-only. Local scans still save in the browser.
SNAPLEDGER_PUBLIC_DEMO=false

# Optional: real receipt recognition through the Anthropic API.
ANTHROPIC_API_KEY=

# Reserved for the Bedrock integration after account allowlisting is approved.
AWS_REGION=us-east-2
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_VISION_MODEL_ID=us.amazon.nova-2-lite-v1:0
